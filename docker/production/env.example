# Copiar/generar FUERA del repositorio. Este ejemplo no contiene secretos.
# Se utiliza: docker compose --env-file /etc/sysforest/sysforest.env -f compose.production.yml ...
SYSFOREST_ENV_FILE=/etc/sysforest/sysforest.env
SYSFOREST_IMAGE=sysforest-app:production
SYSFOREST_HTTP_PORT=18080
APP_NAME=SYSFOREST
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sysforest.example.com
APP_KEY=
JWT_SECRET=
APP_UID=1000
APP_GID=1000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file

DB_DATABASE=sysforest
DB_USERNAME=sysforest_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=sysforest_migrator
DB_MIGRATOR_PASSWORD=
POSTGRES_USER=sysforest_admin
POSTGRES_PASSWORD=

AUDIT_STORE=mongodb
AUDIT_MONGO_URI=mongodb://mongodb:27017
AUDIT_MONGO_DATABASE=sysforest_audit
AUDIT_MONGO_COLLECTION=activity_logs
AUDIT_MONGO_USERNAME=sysforest_audit_app
AUDIT_MONGO_PASSWORD=
MONGO_ROOT_USERNAME=sysforest_mongo_admin
MONGO_ROOT_PASSWORD=

REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sysforest_
CACHE_PREFIX=sysforest_cache_
REDIS_QUEUE_RETRY_AFTER=120
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local
EVIDENCE_DISK=evidences
EVIDENCE_MAX_SIZE_MB=10
EVIDENCE_MAX_FILES=5
EVIDENCE_MAX_BATCH_SIZE_MB=50
EVIDENCE_MAX_PIXELS=20000000
EVIDENCE_ALLOWED_MIMES=image/jpeg,image/png,image/webp
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
BCRYPT_ROUNDS=12
JWT_TTL=10
AUTH_SESSION_TTL_MINUTES=10080
JWT_AUDIENCE=sysforest-web
JWT_MOBILE_AUDIENCE=sysforest-mobile
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
AUTH_PASSWORD_RATE_LIMIT=5
AUTH_INVITATION_RATE_LIMIT=20

# SMTP pendiente: entrega deshabilitada por destino no operativo. No usar el driver log:
# las notificaciones contienen enlaces privados. Configurar antes de habilitar usuarios.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=9
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=SYSFOREST

IMPORTS_MAX_ROWS=100
IMPORTS_MAX_UPLOAD_KB=5120
IMPORTS_PREVIEW_TTL_HOURS=24
IMPORTS_RATE_LIMIT=6
REPORTS_PUBLIC_MAX_ROWS=10000
REPORTS_PRIVATE_MAX_ROWS=50000
REPORTS_PDF_MAX_ROWS=200
REPORTS_AGGREGATE_MAX_ROWS=10000
REPORTS_PUBLIC_RATE_LIMIT=6
REPORTS_PRIVATE_RATE_LIMIT=12

# Presupuesto inicial para VPS de 16 GiB; medir antes de aumentar concurrencia.
APP_MEMORY_LIMIT=2g
POSTGRES_MEMORY_LIMIT=4g
MONGO_MEMORY_LIMIT=2g
MONGO_CACHE_GB=1
REDIS_MEMORY_LIMIT=768m
REDIS_MAXMEMORY=512mb
QUEUE_MEMORY_LIMIT=768m
SCHEDULER_MEMORY_LIMIT=512m
