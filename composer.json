{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sysforest/sysforest",
    "type": "project",
    "description": "Inventario y gestión forestal institucional. Catálogos nacionales de la Fase 5.",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-bcmath": "*",
        "ext-mongodb": "^2.5",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "mongodb/mongodb": "^2.3",
        "openspout/openspout": "^5.11",
        "php-open-source-saver/jwt-auth": "2.9.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "app/Jobs/Infrastructure/InfrastructureProbeJob.php",
            "app/Jobs/Carbon/RefreshCarbonEstimates.php",
            "app/Jobs/Auth/SendSecurityMail.php",
            "app/Models/Users/User.php"
        ]
    },
    "scripts": {
        "format": "pint --preset psr12",
        "lint": "pint --test --preset psr12",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
