# Configuración local. Ejecutar bash bin/setup-env antes del primer arranque.
# Este archivo contiene ejemplos; las claves reales nunca se versionan.
COMPOSE_PROJECT_NAME=sysforest
APP_NAME=SYSFOREST
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_UID=1000
APP_GID=1000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file

# BaseSeeder explícito: administrador inicial; completar la clave solo en el entorno privado.
# Repetir no restablece la contraseña de una cuenta administrativa vigente.
SYSFOREST_BASE_ADMIN_EMAIL=varcor.soluciones@gmail.com
SYSFOREST_BASE_ADMIN_NAME=Varcor
SYSFOREST_BASE_ADMIN_PASSWORD=

# PostgreSQL: Laravel utiliza únicamente el usuario de ejecución.
# Compose toma las claves de .env y las monta como secrets solo donde se necesitan.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sysforest
DB_TEST_DATABASE=sysforest_testing
DB_USERNAME=sysforest_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=sysforest_migrator
DB_MIGRATOR_PASSWORD=
POSTGRES_USER=sysforest_admin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Auditoría: MongoDB privado, sin puertos publicados ni permisos de modificación/borrado.
# bin/setup-env genera ambas claves; la clave root solo se monta en MongoDB.
AUDIT_STORE=mongodb
AUDIT_MONGO_URI=mongodb://mongodb:27017
AUDIT_MONGO_DATABASE=sysforest_audit
AUDIT_MONGO_COLLECTION=activity_logs
AUDIT_MONGO_USERNAME=sysforest_audit_app
AUDIT_MONGO_PASSWORD=
MONGO_ROOT_USERNAME=sysforest_mongo_admin
MONGO_ROOT_PASSWORD=

# Redis no publica puertos en el equipo. AOF preserva colas y datos entre reinicios.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sysforest_
CACHE_STORE=redis
CACHE_PREFIX=sysforest_cache_
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Almacenamiento local privado y logs de contenedores.
FILESYSTEM_DISK=local
# Fotografías privadas. Los máximos de PHP/Nginx deben revisarse si aumentan estos límites.
EVIDENCE_DISK=evidences
EVIDENCE_MAX_SIZE_MB=10
EVIDENCE_MAX_FILES=5
EVIDENCE_MAX_BATCH_SIZE_MB=50
EVIDENCE_MAX_PIXELS=20000000
EVIDENCE_ALLOWED_MIMES=image/jpeg,image/png,image/webp
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
BCRYPT_ROUNDS=12

# SMTP local captura correo en Mailpit; nunca se envía a proveedores externos por defecto.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notificaciones@sysforest.test
MAIL_FROM_NAME=SYSFOREST

# Clave JWT independiente de APP_KEY; generar con bin/setup-env. TTL en minutos.
JWT_SECRET=
JWT_TTL=10
AUTH_SESSION_TTL_MINUTES=10080
JWT_AUDIENCE=sysforest-web
# JWT_ISSUER se deriva de APP_URL si no se define.

# Límites por minuto: IP + correo normalizado cuando corresponda.
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
AUTH_PASSWORD_RATE_LIMIT=5
AUTH_INVITATION_RATE_LIMIT=20

# Nunca colocar contraseñas reales en este archivo ni en documentación.

# Reportes y descargas síncronas: límites públicos, privados y PDF.
# Importación oficial: límites completos por lote y vigencia de su vista previa.
IMPORTS_MAX_ROWS=100
IMPORTS_MAX_UPLOAD_KB=5120
IMPORTS_PREVIEW_TTL_HOURS=24
IMPORTS_RATE_LIMIT=6

REPORTS_PUBLIC_MAX_ROWS=10000
REPORTS_PRIVATE_MAX_ROWS=50000
REPORTS_PDF_MAX_ROWS=200
REPORTS_AGGREGATE_MAX_ROWS=10000
REPORTS_PUBLIC_RATE_LIMIT=6
REPORTS_PRIVATE_RATE_LIMIT=12
