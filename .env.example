# Configuración local. Ejecutar bash bin/setup-env antes del primer arranque.
# Este archivo contiene ejemplos; las claves reales nunca se versionan.
COMPOSE_PROJECT_NAME=sysforest
APP_NAME=SYSFOREST
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_UID=1000
APP_GID=1000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file

# PostgreSQL: Laravel utiliza únicamente el usuario de ejecución.
# Compose toma las claves de .env y las monta como secrets solo donde se necesitan.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sysforest
DB_TEST_DATABASE=sysforest_testing
DB_USERNAME=sysforest_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=sysforest_migrator
DB_MIGRATOR_PASSWORD=
POSTGRES_USER=sysforest_admin
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Redis no publica puertos en el equipo. AOF preserva colas y datos entre reinicios.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=sysforest_
CACHE_STORE=redis
CACHE_PREFIX=sysforest_cache_
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Almacenamiento local privado y logs de contenedores.
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
BCRYPT_ROUNDS=12

# En esta fase el transporte log evita enviar correos reales.
# SMTP se configurará al implementar autenticación y notificaciones.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notificaciones@sysforest.test
MAIL_FROM_NAME=SYSFOREST

# JWT se implementará en Fase 4; no hay autenticación simulada en Fase 2.
# Su configuración final conservará cookies HttpOnly, rotación y revocación.
