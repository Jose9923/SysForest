#!/usr/bin/env python3
"""Instala o consulta los visores privados, sin migrar ni recrear datos."""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import socket
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
PROJECT = 'sysforest-database-viewers'
NETWORK = 'sysforest-production_backend'
PORTS = {'phppgadmin': 18084, 'mongo-express': 18085}
IDENTIFIER = re.compile(r'[a-zA-Z][a-zA-Z0-9_]{0,62}')


class InstallationError(Exception):
    pass


def require(condition, message):
    if not condition:
        raise InstallationError(message)


def run(command, *, payload=None, env=None, phase='operación', timeout=300):
    try:
        result = subprocess.run(command, input=payload, env=env, text=True,
                                capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        raise InstallationError(f'No se completó {phase}; no se muestran secretos ni salida privada.') from None
    require(result.returncode == 0,
            f'Falló {phase} (código {result.returncode}). Se conservó la configuración privada para reintentar.')
    return result.stdout


def inspected(container):
    return json.loads(run(['docker', 'inspect', container], phase='lectura del contenedor'))[0]


def write_private(path, text, uid=0):
    require(not path.exists() and not path.is_symlink(), f'El archivo {path.name} ya existe; no se sobrescribe.')
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, 'w') as handle:
        handle.write(text)
    os.chown(path, uid, 0)


def read_private(path, uid=0):
    require(path.is_file() and not path.is_symlink(), f'Falta el archivo privado {path.name}.')
    info = path.stat()
    require(info.st_uid == uid and info.st_mode & 0o777 == 0o600,
            f'El propietario o los permisos de {path.name} no son los esperados.')
    return path.read_text().strip()


def save_report(path, report):
    temporary = path.with_name('.' + path.name + '.new')
    require(not temporary.exists() and not temporary.is_symlink(), 'Existe un informe temporal pendiente: conservarlo con otro nombre privado antes de repetir; no borrar el estado.')
    write_private(temporary, json.dumps(report, ensure_ascii=False, indent=2) + '\n')
    os.replace(temporary, path)



def optional_container(service):
    name = f'{PROJECT}-{service}-1'
    matches = run(['docker', 'ps', '-a', '--filter', 'name=^/' + name + '$', '--format', '{{.ID}}'],
                  phase='inventario del visor').splitlines()
    require(len(matches) <= 1, 'Hay más de un contenedor con el nombre reservado.')
    if not matches:
        return None
    value = inspected(matches[0])
    labels = value['Config']['Labels'] or {}
    require(value['Name'] == '/' + name and labels.get('com.docker.compose.project') == PROJECT
            and labels.get('com.docker.compose.service') == service
            and labels.get('com.docker.compose.project.working_dir') == str(ROOT),
            'El nombre del visor pertenece a otro contexto; no se modifica.')
    port = 18084 if service == 'pgadmin' else PORTS[service]
    target = '8081/tcp' if service == 'mongo-express' else '8080/tcp'
    require(value['HostConfig']['PortBindings'] == {target: [{'HostIp': '127.0.0.1', 'HostPort': str(port)}]},
            'La publicación del visor existente no coincide con el puerto privado autorizado.')
    require(NETWORK in value['NetworkSettings']['Networks'], 'El visor no está en la red autorizada.')
    return value


def free_port(port):
    with socket.socket() as listener:
        try:
            listener.bind(('127.0.0.1', port))
        except OSError:
            raise InstallationError(f'El puerto privado {port} está ocupado por otro proceso; no se altera.') from None


def identity(value):
    return {'id': value['Id'], 'image': value['Image'], 'started': value['State']['StartedAt']}


def healthy(value):
    return value['State']['Running'] and value['State'].get('Health', {}).get('Status') == 'healthy'


def wait_healthy(container, timeout=180):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        value = inspected(container)
        if healthy(value):
            return value
        require(value['State']['Running'], 'El visor salió antes de completar su arranque.')
        time.sleep(2)
    raise InstallationError('El visor no quedó saludable dentro del plazo; requiere revisión.')


def backup_private(path):
    """Una preimagen privada estable, sin modificar el archivo o sus secretos."""
    if not path.exists():
        return
    text = read_private(path)
    backup = path.with_name(path.stem + '.before-phppgadmin' + path.suffix)
    if not backup.exists():
        write_private(backup, path.read_text())
    else:
        read_private(backup)


def replace_private(path, text):
    temporary = path.with_name('.' + path.name + '.new')
    require(not temporary.exists() and not temporary.is_symlink(), 'Hay un archivo temporal pendiente: conservarlo con otro nombre privado antes de repetir; no borrar el estado.')
    if path.exists():
        read_private(path)
    write_private(temporary, text)
    os.replace(temporary, path)


def compose_hash(compose, env, service):
    output = run(compose + ['config', '--hash', service], env=env, phase='huella de configuración del visor').strip().split()
    require(len(output) == 2 and output[0] == service and re.fullmatch(r'[a-f0-9]{64}', output[1]),
            'Compose no devolvió la huella esperada del servicio.')
    return output[1]


def container_image_identity(value):
    """Compara el manifiesto de plataforma; Image solo en motores sin descriptor."""
    descriptor = value.get('ImageManifestDescriptor')
    if descriptor is not None:
        require(isinstance(descriptor, dict), 'El descriptor de plataforma no tiene el formato esperado.')
        require(isinstance(descriptor.get('digest'), str)
                and bool(re.fullmatch(r'sha256:[a-f0-9]{64}', descriptor['digest'])),
                'La huella del manifiesto de plataforma no es válida.')
        require(descriptor.get('mediaType') in ['application/vnd.oci.image.manifest.v1+json',
                                              'application/vnd.docker.distribution.manifest.v2+json'],
                'Se requiere un manifiesto de plataforma OCI/Docker, no un índice.')
        require(type(descriptor.get('size')) is int and descriptor['size'] > 0,
                'El tamaño del manifiesto de plataforma no es válido.')
        platform = descriptor.get('platform')
        require(isinstance(platform, dict) and all(isinstance(platform.get(key), str)
                and re.fullmatch(r'[a-z0-9][a-z0-9._-]*', platform[key]) for key in ['os', 'architecture']),
                'El sistema o arquitectura del manifiesto no son válidos.')
        # Se conserva el descriptor completo, incluidos variante y otros metadatos.
        return {'kind': 'platform-manifest', 'descriptor': descriptor}
    image = value.get('Image')
    require(isinstance(image, str) and bool(re.fullmatch(r'sha256:[a-f0-9]{64}', image)),
            'La identidad de imagen del motor anterior no es válida.')
    return {'kind': 'legacy-image', 'image': image}


def runtime_image_identity(image):
    """Resuelve la plataforma local mediante una sonda que nunca se inicia."""
    descriptor = json.loads(run(['docker', 'image', 'inspect', image], phase='descriptor de imagen del visor'))[0]
    require(not descriptor['Config'].get('Volumes'), 'La imagen declara volúmenes implícitos; no se crea la sonda.')
    require(bool(re.fullmatch(r'sha256:[a-f0-9]{64}', descriptor['Id'])), 'El descriptor local de imagen no es válido.')
    token = secrets.token_hex(12)
    name = PROJECT + '-image-identity-' + token
    label = 'sysforest.viewer-image-identity'
    container = None
    try:
        # Crear no ejecuta el entrypoint. La identidad inmutable evita cambios del tag entre lecturas.
        container = run(['docker', 'create', '--pull', 'never', '--name', name, '--label', label + '=' + token,
                         '--network', 'none', '--read-only', '--user', '1000:1000', '--cap-drop', 'ALL',
                         '--security-opt', 'no-new-privileges:true', '--entrypoint', '/bin/true', descriptor['Id']],
                        phase='creación sin arranque de sonda de imagen').strip()
        require(bool(re.fullmatch(r'[a-f0-9]{64}', container)), 'No se identificó la sonda de imagen.')
        value = inspected(container)
        require(value['Name'] == '/' + name and value['Config']['Labels'].get(label) == token
                and value['State']['Status'] == 'created' and not value['State']['Running']
                and value['HostConfig']['NetworkMode'] == 'none' and value['HostConfig']['ReadonlyRootfs']
                and not value['Mounts'], 'La sonda no coincide con el contexto sin ejecución aprobado.')
        return container_image_identity(value)
    finally:
        if container is None:
            # También retirar una creación que completó Docker pero cuya respuesta se interrumpió.
            matches = run(['docker', 'ps', '-a', '-q', '--no-trunc', '--filter', 'name=^/' + name + '$',
                           '--filter', 'label=' + label + '=' + token], phase='localización de sonda propia').splitlines()
            require(len(matches) <= 1, 'Hay una colisión en la identidad de la sonda; requiere revisión.')
            container = matches[0] if matches else None
        if container:
            value = inspected(container)
            require(value['Name'] == '/' + name and value['Config']['Labels'].get(label) == token
                    and not value['State']['Running'], 'La sonda cambió de propietario/estado; no se retira.')
            run(['docker', 'rm', container], phase='retirada exclusiva de sonda sin iniciar')


def same_viewer(value, spec, expected_hash, execution_identity=None):
    expected = execution_identity if execution_identity is not None else runtime_image_identity(spec['image'])
    # Los kinds distintos rechazan descriptor ausente en un solo lado; no hay downgrade silencioso.
    require(container_image_identity(value) == expected
            and value['Config']['Labels'].get('com.docker.compose.config-hash') == expected_hash,
            'El visor existente difiere de su imagen/configuración fijada; no se reconstruye ni reemplaza automáticamente.')
    require(healthy(value), 'El visor existente debe estar saludable; no se reinicia implícitamente.')


def candidate_check(image, password):
    """Prueba el contenedor nuevo sin publicar puertos ni montar secretos."""
    token = secrets.token_hex(8)
    name = PROJECT + '-phppgadmin-candidate-' + token
    container = None
    try:
        container = run(['docker', 'run', '-d', '--name', name, '--label', 'sysforest.viewer-candidate=' + token,
                         '--network', NETWORK, '--user', '1000:1000', '--init', '--read-only',
                         '--tmpfs', '/tmp:rw,noexec,nosuid,nodev,size=64m,mode=1777',
                         '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges:true',
                         '--pids-limit', '128', '--memory', '256m', image], phase='arranque del candidato phpPgAdmin').strip()
        require(bool(re.fullmatch(r'[a-f0-9]{64}', container)), 'No se identificó el candidato.')
        health_php = "ini_set('display_errors','0');$v=@file_get_contents('http://127.0.0.1:8080/health.php');exit($v===false?1:0);"
        deadline = time.monotonic() + 60
        while True:
            require(inspected(container)['State']['Running'], 'El candidato phpPgAdmin no permanece en ejecución.')
            try:
                run(['docker', 'exec', container, 'php', '-r', health_php], phase='salud del candidato', timeout=10)
                break
            except InstallationError:
                require(time.monotonic() < deadline, 'El candidato no respondió antes del cambio de puerto.')
                time.sleep(2)
        # La clave viaja únicamente por stdin; no se monta ni entra en argumentos/env.
        db_php = r"""
ini_set('display_errors','0');ini_set('log_errors','0');
$p=json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR)['password'];
if(!preg_match('/\A[a-f0-9]{64}\z/D',$p))exit(10);
$c=@pg_connect('host=postgres port=5432 dbname=sysforest user=sysforest_viewer connect_timeout=5 password='.$p);
unset($p);if(!$c)exit(11);
$r=@pg_query($c,'BEGIN READ ONLY');if(!$r)exit(12);
$r=@pg_query($c,"SELECT current_user AS u,current_database() AS d,rolsuper,rolcreaterole,rolcreatedb,rolreplication,rolbypassrls FROM pg_roles WHERE rolname=current_user");
$row=$r?pg_fetch_assoc($r):false;
$ok=$row&&$row['u']==='sysforest_viewer'&&$row['d']==='sysforest';
foreach(['rolsuper','rolcreaterole','rolcreatedb','rolreplication','rolbypassrls'] as $f){$ok=$ok&&$row[$f]==='f';}
@pg_query($c,'ROLLBACK');pg_close($c);exit($ok?0:13);
"""
        run(['docker', 'exec', '-i', container, 'php', '-r', db_php], payload=json.dumps({'password': password}),
            phase='login PostgreSQL de consulta del candidato', timeout=30)
        return container_image_identity(inspected(container))
    finally:
        if container:
            value = inspected(container)
            require(value['Config']['Labels'].get('sysforest.viewer-candidate') == token,
                    'El candidato cambió de propietario; no se retira.')
            run(['docker', 'rm', '-f', container], phase='retirada exclusiva del candidato')


def activate_postgres_viewer(compose, env, legacy, current, expected_identity):
    """El fallo de activación recupera solo el pgAdmin anterior que estaba activo."""
    stopped_legacy = False
    try:
        if legacy and legacy['State']['Running']:
            # La identidad/puerto y el volumen ya se validaron antes de construir.
            stopped_legacy = True
            run(['docker', 'stop', '--time', '30', legacy['Id']], phase='pausa del pgAdmin anterior')
        if not current or not current['State']['Running']:
            free_port(18084)
        run(compose + ['up', '-d', '--no-deps', '--no-build', '--wait', '--wait-timeout', '180', 'phppgadmin'],
            env=env, phase='activación exclusiva de phpPgAdmin', timeout=240)
        value = optional_container('phppgadmin')
        require(value is not None and container_image_identity(value) == expected_identity and healthy(value),
                'La imagen nueva no quedó activa y saludable.')
        return value
    except (Exception, KeyboardInterrupt):
        if stopped_legacy and not inspected(legacy['Id'])['State']['Running']:
            new = optional_container('phppgadmin')
            if new and new['State']['Running']:
                run(['docker', 'stop', '--time', '30', new['Id']], phase='pausa del phpPgAdmin fallido')
            free_port(18084)
            run(['docker', 'start', legacy['Id']], phase='recuperación exclusiva del pgAdmin anterior')
            wait_healthy(legacy['Id'])
        raise


def prepare_accounts(baseline, names, services, values):
    pg_wrapper = '''set -eu
    IFS= read -r SYSFOREST_VIEWER_PASSWORD
    export SYSFOREST_VIEWER_PASSWORD
    PGPASSWORD=$(cat "$POSTGRES_PASSWORD_FILE")
    export PGPASSWORD
    export DB_DATABASE="$1" DB_USERNAME="$2" DB_MIGRATOR_USERNAME="$3" PG_VIEWER_USERNAME=sysforest_viewer
    exec psql --no-psqlrc --quiet --set=ON_ERROR_STOP=1 --username="$POSTGRES_USER" --dbname="$DB_DATABASE" --file=/dev/stdin
    '''
    pg_script = (ROOT / 'docker/database-viewers/postgres-readonly.sql').read_text()
    run(['docker', 'exec', '-i', baseline['postgres']['id'], 'sh', '-c', pg_wrapper, 'sh',
         names['database'], names['app_user'], names['migrator']],
        payload=values['postgres_viewer_password'] + '\n' + pg_script,
        phase='preparación del usuario PostgreSQL')
    mongo_script = (ROOT / 'docker/database-viewers/mongo-readonly.js').read_text()
    mongo_admin = services['mongodb']['environment']['MONGO_INITDB_ROOT_USERNAME']
    require(IDENTIFIER.fullmatch(mongo_admin), 'El nombre administrativo de MongoDB no es válido.')
    run(['docker', 'exec', '-i', '-e', 'MONGO_VIEWER_USERNAME=sysforest_audit_viewer',
         '-e', f'MONGO_ROOT_USERNAME={mongo_admin}',
         '-e', 'MONGO_ROOT_PASSWORD_FILE=/run/secrets/mongo_root_password',
         baseline['mongodb']['id'], 'mongosh', '--quiet', '--norc', '--nodb', '--eval', mongo_script],
        payload=json.dumps({'password': values['mongo_viewer_password']}),
        phase='preparación del usuario MongoDB')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['install', 'status', 'credentials'])
    parser.add_argument('--production-dir', default='/opt/sysforest/releases/20261104-initial')
    parser.add_argument('--env-file', default='/opt/sysforest/private/production.env')
    parser.add_argument('--state-dir', default='/opt/sysforest/private/database-viewers')
    args = parser.parse_args()
    require(os.geteuid() == 0, 'Ejecuta este comando como root en el servidor.')
    os.umask(0o077)
    state = Path(args.state_dir)
    require(state.is_absolute() and not state.is_symlink(), 'El directorio privado debe ser absoluto y no un enlace.')
    require(state.resolve() == state and state.parent == Path('/opt/sysforest/private'),
            'El directorio de estado debe estar directamente bajo /opt/sysforest/private.')
    require(not state.is_relative_to(ROOT), 'Los secretos deben quedar fuera del repositorio.')
    if args.action == 'credentials':
        print(read_private(state / 'access.txt'))
        return
    if args.action == 'status':
        for service, port in PORTS.items():
            value = inspected(f'{PROJECT}-{service}-1')
            print(f"{service}: {value['State']['Status']} / {value['State'].get('Health', {}).get('Status', 'sin healthcheck')} · http://127.0.0.1:{port}")
        return

    production = Path(args.production_dir)
    private_env = Path(args.env_file)
    require(production.is_absolute() and production.resolve() == production,
            'El release debe ser una ruta absoluta real.')
    require((production / 'compose.production.yml').is_file(), 'No existe el Compose productivo indicado.')
    require(private_env.is_absolute() and private_env.is_file() and not private_env.is_symlink(),
            'No se encontró el entorno privado.')
    require(private_env.stat().st_uid == 0 and private_env.stat().st_mode & 0o077 == 0,
            'El entorno privado debe pertenecer a root y no ser accesible a otros usuarios.')
    require(not private_env.is_relative_to(ROOT), 'El entorno de producción no puede estar en el repositorio.')
    before_env = hashlib.sha256(private_env.read_bytes()).hexdigest()
    env = dict(os.environ, SYSFOREST_ENV_FILE=str(private_env))
    production_compose = ['docker', 'compose', '--project-name', 'sysforest-production',
                          '--project-directory', str(production), '--env-file', str(private_env),
                          '--profile', 'maintenance',
                          '-f', str(production / 'compose.production.yml')]
    config = json.loads(run(production_compose + ['config', '--format', 'json'],
                            env=env, phase='validación de configuración productiva'))
    services = config['services']
    app_env = services['app']['environment']
    require(app_env['APP_ENV'] == 'production', 'La configuración no es productiva.')
    names = {
        'database': app_env['DB_DATABASE'],
        'app_user': app_env['DB_USERNAME'],
        'migrator': services['migrate']['environment']['DB_USERNAME'],
        'mongo_database': services['mongodb']['environment']['AUDIT_MONGO_DATABASE'],
        'mongo_collection': services['mongodb']['environment']['AUDIT_MONGO_COLLECTION'],
        'mongo_app_user': services['mongodb']['environment']['AUDIT_MONGO_USERNAME'],
    }
    require(all(isinstance(value, str) and IDENTIFIER.fullmatch(value) for value in names.values()),
            'Hay identificadores de base no admitidos.')
    require(names['database'] == 'sysforest' and names['mongo_database'] == 'sysforest_audit'
            and names['mongo_collection'] == 'activity_logs',
            'Los visores versionados están preparados para sysforest y su colección activity_logs.')
    baseline = {}
    for service in ['app', 'queue', 'scheduler', 'nginx', 'postgres', 'mongodb', 'redis']:
        value = inspected(f'sysforest-production-{service}-1')
        labels = value['Config']['Labels']
        require(labels.get('com.docker.compose.project') == 'sysforest-production'
                and labels.get('com.docker.compose.service') == service
                and labels.get('com.docker.compose.project.working_dir') == str(production),
                'El release no coincide con los contenedores de producción.')
        require(value['State']['Running'] and value['State'].get('Health', {}).get('Status') == 'healthy',
                f'El servicio {service} debe estar saludable antes de instalar.')
        baseline[service] = {'id': value['Id'], 'image': value['Image'], 'started': value['State']['StartedAt']}
    network = json.loads(run(['docker', 'network', 'inspect', NETWORK], phase='validación de red privada'))[0]
    require(network['Labels'].get('com.docker.compose.project') == 'sysforest-production', 'La red no pertenece a SysForest.')

    state.mkdir(mode=0o700, exist_ok=True)
    require(state.stat().st_uid == 0 and state.stat().st_mode & 0o777 == 0o700,
            'El directorio privado debe pertenecer a root y tener modo0700.')
    with (state / '.install.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise InstallationError('Hay otra instalación de visores en curso.') from None
        settings_path = state / 'settings.json'
        if settings_path.exists():
            settings = json.loads(read_private(settings_path))
            require(settings.get('format') in ['SYSFOREST_DATABASE_VIEWERS_V1', 'SYSFOREST_DATABASE_VIEWERS_V2']
                    and settings['names'] == names, 'La instalación existente corresponde a otro contexto; no se reemplaza.')
        else:
            require([p.name for p in state.iterdir()] == ['.install.lock'],
                    'El directorio contiene archivos sin manifiesto; revisa antes de inicializar.')
            settings = {'format': 'SYSFOREST_DATABASE_VIEWERS_V2', 'names': names, 'installation_completed': False,
                        'created_at': datetime.datetime.now(datetime.timezone.utc).isoformat()}
            write_private(settings_path, json.dumps(settings, indent=2) + '\n')
        legacy_format = settings['format'] == 'SYSFOREST_DATABASE_VIEWERS_V1'
        provision_accounts = not (state / 'installation.json').exists() and not settings.get('installation_completed', False)
        secret_owners = {'postgres_viewer_password': 0, 'mongo_express_password': 1000, 'mongo_viewer_password': 1000,
                         'mongo_cookie_secret': 1000, 'mongo_session_secret': 1000}
        if legacy_format or (state / 'pgadmin_password').exists():
            secret_owners['pgadmin_password'] = 5050
        values = {}
        for filename, uid in secret_owners.items():
            path = state / filename
            if not path.exists():
                require(provision_accounts and not legacy_format, 'Falta un secreto de la instalación anterior; no se regenera.')
                write_private(path, secrets.token_hex(32) + '\n', uid)
            values[filename] = read_private(path, uid)
            require(bool(re.fullmatch(r'[a-f0-9]{64}', values[filename])), 'Un secreto existente no tiene el formato generado; no se cambia.')
        mongo_username = state / 'mongo_express_username'
        if not mongo_username.exists():
            require(provision_accounts and not legacy_format, 'Falta el usuario web anterior; no se sustituye.')
            write_private(mongo_username, 'sysforest\n', 1000)
        require(read_private(mongo_username, 1000) == 'sysforest', 'El usuario web existente no coincide.')
        if legacy_format or (state / 'postgres_viewer_pgpass').exists():
            pgpass = f"postgres:5432:{names['database']}:sysforest_viewer:{values['postgres_viewer_password']}"
            require(read_private(state / 'postgres_viewer_pgpass', 5050) == pgpass,
                    'El pgpass anterior no coincide; se conserva sin rotación.')
        preserved_secrets = {name: hashlib.sha256((state / name).read_bytes()).hexdigest()
                             for name in [*secret_owners, 'mongo_express_username']}
        if (state / 'postgres_viewer_pgpass').exists():
            preserved_secrets['postgres_viewer_pgpass'] = hashlib.sha256((state / 'postgres_viewer_pgpass').read_bytes()).hexdigest()
        compose_env = dict(os.environ, SYSFOREST_VIEWERS_SECRETS_DIR=str(state), COMPOSE_IGNORE_ORPHANS='true')
        compose = ['docker', 'compose', '--project-name', PROJECT, '--project-directory', str(ROOT),
                   '-f', str(ROOT / 'compose.database-viewers.yml')]
        viewer_config = json.loads(run(compose + ['config', '--format', 'json'], env=compose_env,
                                       phase='validación del Compose de visores'))
        require(set(viewer_config['services']) == set(PORTS), 'El Compose debe contener solo los dos visores actuales.')
        required_secrets = {'mongo_express_username', 'mongo_express_password', 'mongo_viewer_password',
                            'mongo_cookie_secret', 'mongo_session_secret'}
        require(set(viewer_config['secrets']) == required_secrets
                and all(Path(viewer_config['secrets'][name]['file']).resolve() == state / name for name in required_secrets),
                'Los secretos del Compose no coinciden con el directorio privado seleccionado.')
        require(viewer_config['networks']['backend'].get('external') is True
                and viewer_config['networks']['backend']['name'] == NETWORK, 'La red de los visores no coincide.')
        for service, port in PORTS.items():
            entries = viewer_config['services'][service]['ports']
            require(len(entries) == 1 and entries[0]['host_ip'] == '127.0.0.1' and int(entries[0]['published']) == port
                    and int(entries[0]['target']) == (8080 if service == 'phppgadmin' else 8081),
                    'Los visores solo pueden publicarse en sus puertos loopback autorizados.')
        pg_spec = viewer_config['services']['phppgadmin']
        require(pg_spec['user'] == '1000:1000' and pg_spec.get('read_only') is True
                and not pg_spec.get('secrets') and not pg_spec.get('volumes') and not pg_spec.get('environment'),
                'phpPgAdmin debe usar UID1000, filesystem de lectura y ningún secreto/volumen/entorno de acceso.')
        require(set(pg_spec.get('cap_drop', [])) == {'ALL'}
                and 'no-new-privileges:true' in pg_spec.get('security_opt', [])
                and pg_spec.get('tmpfs') == ['/tmp:rw,noexec,nosuid,nodev,size=64m,mode=1777'],
                'Los límites del contenedor phpPgAdmin no coinciden con el contrato revisado.')
        current = optional_container('phppgadmin')
        legacy = optional_container('pgadmin')
        mongo = optional_container('mongo-express')
        require(not (current and current['State']['Running'] and legacy and legacy['State']['Running']),
                'Ambos visores PostgreSQL figuran activos; revisar antes de cambiar el puerto.')
        if legacy:
            require(legacy_format or settings.get('legacy_pgadmin', {}).get('id') == legacy['Id'],
                    'El pgAdmin existente no está registrado para esta instalación.')
            mounts = [m for m in legacy['Mounts'] if m['Destination'] == '/var/lib/pgadmin']
            require(len(mounts) == 1 and mounts[0]['Type'] == 'volume'
                    and mounts[0]['Name'] == PROJECT + '_pgadmin_data', 'El volumen pgAdmin anterior no es el esperado.')
            volume = json.loads(run(['docker', 'volume', 'inspect', mounts[0]['Name']], phase='propietario del volumen pgAdmin'))[0]
            require((volume.get('Labels') or {}).get('com.docker.compose.project') == PROJECT
                    and (volume.get('Labels') or {}).get('com.docker.compose.volume') == 'pgadmin_data',
                    'El volumen anterior pertenece a otro proyecto; no se modifica.')
            if legacy['State']['Running']:
                require(healthy(legacy), 'El pgAdmin anterior debe estar saludable para una recuperación segura.')
        if not any(v and v['State']['Running'] for v in [legacy, current]):
            free_port(18084)
        mongo_hash = compose_hash(compose, compose_env, 'mongo-express')
        mongo_baseline = None
        if mongo:
            same_viewer(mongo, viewer_config['services']['mongo-express'], mongo_hash)
            mongo_baseline = identity(mongo)
        else:
            free_port(18085)
        print('Preparando y comprobando phpPgAdmin antes de cambiar el visor activo...', flush=True)
        run(compose + ['build', 'phppgadmin'], env=compose_env, phase='compilación de phpPgAdmin', timeout=1200)
        if provision_accounts:
            print('Preparando las cuentas exclusivas de consulta de la instalación inicial...', flush=True)
            prepare_accounts(baseline, names, services, values)
        expected_identity = candidate_check(pg_spec['image'], values['postgres_viewer_password'])
        # Mongo existente nunca recibe build/up/restart. Si cambia su contrato se abortó arriba.
        if not mongo:
            run(compose + ['build', 'mongo-express'], env=compose_env, phase='compilación inicial de Mongo Express', timeout=1200)
            run(compose + ['up', '-d', '--no-deps', '--no-build', '--wait', '--wait-timeout', '180', 'mongo-express'],
                env=compose_env, phase='arranque inicial de Mongo Express', timeout=240)
            mongo = optional_container('mongo-express')
        for filename in ['settings.json', 'installation.json', 'access.txt']:
            backup_private(state / filename)
        # Revalidar propietarios/puertos justo antes de pausar el único visor reemplazado.
        require((optional_container('pgadmin') or {}).get('Id') == (legacy or {}).get('Id'), 'pgAdmin cambió durante la preparación.')
        require((optional_container('phppgadmin') or {}).get('Id') == (current or {}).get('Id'), 'phpPgAdmin cambió durante la preparación.')
        if current and healthy(current) and container_image_identity(current) == expected_identity:
            same_viewer(current, pg_spec, compose_hash(compose, compose_env, 'phppgadmin'), expected_identity)
            pg = current
        else:
            pg = activate_postgres_viewer(compose, compose_env, legacy, current, expected_identity)
        after = {}
        for service, previous in baseline.items():
            value = inspected(previous['id'])
            require(identity(value) == previous and healthy(value), 'Un servicio productivo cambió durante la instalación; revisa concurrencia.')
            after[service] = identity(value)
        require(hashlib.sha256(private_env.read_bytes()).hexdigest() == before_env, 'El entorno productivo cambió durante la instalación.')
        if mongo_baseline:
            require(identity(optional_container('mongo-express')) == mongo_baseline and healthy(optional_container('mongo-express')),
                    'Mongo Express cambió durante el reemplazo; requiere revisión.')
        for name, checksum in preserved_secrets.items():
            require(hashlib.sha256((state / name).read_bytes()).hexdigest() == checksum, 'Un secreto previo cambió; no se publica el acceso.')
        if legacy:
            require(not inspected(legacy['Id'])['State']['Running'], 'pgAdmin anterior debe permanecer detenido para recuperación.')
            settings['legacy_pgadmin'] = {'id': legacy['Id'], 'image': legacy['Image'], 'volume': PROJECT + '_pgadmin_data',
                                         'retained_stopped': True}
        ui = {s: {'image': optional_container(s)['Image'], 'url': f'http://127.0.0.1:{port}', 'healthy': healthy(optional_container(s))}
              for s, port in PORTS.items()}
        require(all(v['healthy'] for v in ui.values()), 'Un visor no está saludable al cerrar la instalación.')
        access = (f'SYSFOREST · acceso privado a visores\n\n'
                  f'phpPgAdmin: http://127.0.0.1:18084\nServidor: SysForest\nBase: sysforest\n'
                  f'Usuario PostgreSQL: sysforest_viewer\nContraseña: {values["postgres_viewer_password"]}\n\n'
                  f'Mongo Express: http://127.0.0.1:18085\nUsuario: sysforest\nContraseña: {values["mongo_express_password"]}\n\n'
                  'Abre primero el túnel SSH. phpPgAdmin usa login nativo de base, sin acceso automático. '
                  'Estas cuentas consultan datos de distintas instituciones; no son roles de la aplicación.\n')
        # Desde aquí ambos visores ya están saludables. Un fallo de publicación
        # privada no revierte el servicio ni toca Mongo: repetir install completa
        # settings/access/informe. Conservar cualquier .new incompleto por separado
        # antes de repetir; nunca borrar settings, secretos ni el volumen anterior.
        if not (state / 'access.txt').exists() or (state / 'access.txt').read_text() != access:
            replace_private(state / 'access.txt', access)
        settings.update({'format': 'SYSFOREST_DATABASE_VIEWERS_V2', 'installation_completed': True,
                         'postgres_panel': 'phppgadmin'})
        save_report(settings_path, settings)
        report = {'format': 'SYSFOREST_DATABASE_VIEWERS_INSTALL_V2',
                  'installed_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  'source': str(ROOT), 'panels': ui, 'production_containers_unchanged': after,
                  'mongo_express_unchanged': mongo_baseline is not None, 'preserved_secret_files': len(preserved_secrets),
                  'legacy_pgadmin': settings.get('legacy_pgadmin'), 'environment_unchanged': True,
                  'no_migrations_or_seeders': True, 'credentials_file': str(state / 'access.txt')}
        save_report(state / 'installation.json', report)
        print('phpPgAdmin y Mongo Express saludables. Servicios y entorno de SysForest conservados.')
        print(f'Accesos privados guardados en {state / "access.txt"}; no se imprimieron contraseñas.')
        print('Para abrirlos desde tu equipo: bin/database-viewers-tunnel root@TU_SERVIDOR')


if __name__ == '__main__':
    try:
        main()
    except (InstallationError, KeyError, ValueError, OSError) as error:
        message = str(error) if isinstance(error, InstallationError) else 'Configuración inesperada; no se muestran datos privados.'
        print('Error: ' + message, file=sys.stderr)
        sys.exit(1)
