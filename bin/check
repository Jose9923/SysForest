#!/usr/bin/env bash
set -Eeuo pipefail

# Revisa formato y sintaxis del checkout; no ejecuta pruebas ni accede a bases de datos.
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd -- "$project_dir"

usage() {
    cat <<'HELP'
Uso: bash bin/check [all|php|frontend|lint]

  all       PSR-12 y sintaxis de JavaScript/PHP (predeterminado).
  php       Comprueba sintaxis PHP con php -l, sin iniciar Laravel.
  frontend  Comprueba sintaxis JavaScript con node --check.
  lint      Comprueba PSR-12 sin modificar archivos.

Las pruebas automatizadas fueron retiradas por solicitud del usuario.
Requisitos: Ubuntu/WSL, flock, Docker e imagen sysforest-app:local para php/lint;
Node para frontend. No requiere servicios Compose ni conexión a bases de datos.
Los resultados quedan en storage/app/checks/<ejecución>/, fuera de Git.
HELP
}

mode="${1:-all}"
if [[ "$#" -gt 1 ]]; then usage >&2; exit 2; fi
case "$mode" in
    all|php|frontend|lint) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'Falta el comando requerido: %s. No se ejecutó la revisión.\n' "$1" >&2
        exit 1
    fi
}

require_command flock
if [[ "$mode" == all || "$mode" == frontend ]]; then require_command node; fi
if [[ "$mode" != frontend ]]; then require_command docker; fi

mkdir -p storage/app/checks
exec 9>storage/app/checks/check.lock
if ! flock -n 9; then
    printf '%s\n' 'Ya hay una revisión bin/check en este checkout. Espera a que termine.' >&2
    exit 1
fi
result_dir="$(mktemp -d "$project_dir/storage/app/checks/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")"
printf 'Modo: %s\nResultados: %s\n' "$mode" "$result_dir"
trap 'check_status=$?; printf "Código de salida: %s\n" "$check_status" | tee "$result_dir/status.txt"; exit "$check_status"' EXIT

run_step() {
    local log_name="$1"
    shift
    "$@" 2>&1 | tee "$result_dir/$log_name.log"
}

check_lint() {
    run_step lint docker run --rm --user "$(id -u):$(id -g)" \
        --mount "type=bind,src=$project_dir,dst=/workspace,readonly" \
        --workdir /workspace --entrypoint /var/www/html/vendor/bin/pint sysforest-app:local \
        --test --preset psr12 --cache-file=/tmp/sysforest-pint.cache
}

check_frontend_files() {
    local file
    local count=0
    while IFS= read -r -d '' file; do
        node --check "$file"
        count=$((count + 1))
    done < <(find public/js resources/js -type f -name '*.js' -print0)
    printf 'Sintaxis JavaScript correcta: %s archivos.\n' "$count"
}

check_frontend() {
    run_step frontend check_frontend_files
}

check_php() {
    # php -l analiza cada archivo sin ejecutar instrucciones de la aplicación.
    run_step php docker run --rm --user "$(id -u):$(id -g)" \
        --mount "type=bind,src=$project_dir,dst=/workspace,readonly" \
        --workdir /workspace --entrypoint /bin/bash sysforest-app:local -c '
set -Eeuo pipefail
count=0
while IFS= read -r -d "" file; do
    php -l "$file"
    count=$((count + 1))
done < <(find app bootstrap config database routes public docker/php -type f -name "*.php" ! -path "bootstrap/cache/*" -print0)
php -l artisan
printf "Sintaxis PHP correcta: %s archivos.\n" "$((count + 1))"
'
}

case "$mode" in
    all) check_lint; check_frontend; check_php ;;
    php) check_php ;;
    frontend) check_frontend ;;
    lint) check_lint ;;
esac
printf '%s\n' 'Revisión estática completada. No se ejecutaron pruebas automatizadas.'
